vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
    dark-theme-id: 200
    pad: 32
    center: true
  }
}

direction: right

feedback: Fast PR feedback\nOnly affected gates {shape: hexagon}
queue: One merge-group\nbuild at a time {shape: queue}
current: Current-base\ncomplete diff
native: Apple, tuner,\nmacOS harness
other: Go, Web, Android,\ndocs, images
required: Required CI {shape: hexagon}
main: Main {shape: page}

feedback -> queue: eligible
queue -> current
current -> native -> required
current -> other -> required
required -> main
