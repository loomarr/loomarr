vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
    dark-theme-id: 200
    pad: 32
    center: true
  }
}

direction: right

inputs: Change enters CI {
  shape: oval
}

orchestrator: Root ci.yml owns decisions {
  classifier: Fail-closed\npath classifier {shape: hexagon}
  admission: PR feedback or\none-at-a-time queue {shape: queue}
  aggregate: Required CI\naggregate {shape: hexagon}

  classifier -> admission: affected families
}

families: Reusable family workflows {
  direction: down
  policy: Policy + contracts
  go: Go + Postgres + Rust
  web: Web + browser + image
  native: Apple + Android + TV
  docs: Docs
}

main: Main {shape: page}

inputs -> orchestrator.classifier
orchestrator.admission -> families.policy: always when orchestration changes
orchestrator.admission -> families.go: only owned inputs
orchestrator.admission -> families.web: only owned inputs
orchestrator.admission -> families.native: queue, main, or manual
orchestrator.admission -> families.docs: only owned inputs
families.policy -> orchestrator.aggregate
families.go -> orchestrator.aggregate
families.web -> orchestrator.aggregate
families.native -> orchestrator.aggregate
families.docs -> orchestrator.aggregate
orchestrator.aggregate -> main
