# Question: how does a change get from a pull request onto main?
# Reads top to bottom: the classifier picks which families run, every family reports to one
# required aggregate, and only the aggregate gates the merge.
...@system/theme

direction: down

change: A pull request {class: audience; icon: icons/audience-git-pull-request.svg}

ci: ci.yml {
  class: boundary
  classify: Path classifier {class: loomarr; icon: icons/loomarr-workflow.svg}
  admit: PR or queue {class: loomarr; icon: icons/loomarr-list-checks.svg}
  # Rows first, then columns, so the grid fills row by row.
  families: {
    class: zone
    label: Family workflows
    grid-rows: 2
    grid-columns: 3
    policy: Policy and contracts {class: service}
    go: Go and Rust {class: service}
    web: Web and browser {class: service}
    native: Apple, Android, TV {class: service}
    docs: Docs {class: service}
  }
  aggregate: Required check {class: loomarr; icon: icons/loomarr-shield-check.svg}
}

main: main {class: service; icon: icons/service-git-merge.svg}

change -> ci.classify: {class: hot}
ci.classify -> ci.admit: affected families {class: hot}
ci.admit -> ci.families: only what changed {class: hot}
ci.families -> ci.aggregate: every result {class: hot}
ci.aggregate -> main: {class: hot}
