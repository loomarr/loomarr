# Question: what are Loomarr's parts, and what does it talk to?
# Reads top to bottom: a sentence goes in at the top, a channel comes out at the bottom.
# Tunarr is the alternative backend: Loomarr still schedules and hands Tunarr the result.
...@system/theme

direction: down

people: People {class: audience; icon: icons/audience-users.svg}
tmdb: TMDB {class: service; icon: icons/service-film.svg}
llm: LLM {class: service; icon: icons/service-brain.svg}

loomarr: Loomarr {
  class: boundary
  suggest: Suggester {class: loomarr; icon: icons/loomarr-sparkles.svg}
  build: Channel builder {class: loomarr; icon: icons/loomarr-list-plus.svg}
  filler: Filler {class: loomarr; icon: icons/loomarr-clapperboard.svg}
  schedule: Scheduler {class: loomarr; icon: icons/loomarr-calendar-clock.svg}
  playout: Playout {class: loomarr; icon: icons/loomarr-radio-tower.svg}
}

req: Seerr or *arr {class: service; icon: icons/service-download.svg}
tunarr: Tunarr, if chosen {class: service; icon: icons/service-server.svg}
media: Emby or Jellyfin {class: service; icon: icons/service-server.svg}
screens: TVs and browsers {class: audience; icon: icons/audience-tv.svg}

people -> loomarr.suggest: {class: hot}
tmdb -> loomarr.suggest: {class: flow}
llm -> loomarr.suggest: {class: flow}
loomarr.suggest -> loomarr.build: {class: hot}
loomarr.build -> loomarr.schedule: {class: hot}
loomarr.filler -> loomarr.schedule: {class: flow}
loomarr.schedule -> loomarr.playout: {class: hot}
loomarr.build -> req: {class: flow}
req -> media: new titles {class: flow}
loomarr.playout -> media: Live TV {class: hot}
loomarr.schedule -> tunarr: {class: flow}
tunarr -> media: Live TV {class: flow}
media -> screens: {class: hot}
