# loomarr-ingest sidecar image (design §10, §16). SEPARATE from the core so the
# ~170MB of yt-dlp + ffmpeg tooling never touches the distroless core binary.
# Only the `filler` compose profile pulls this. Go binary + the two vendored CLI
# tools it shells out to.

# ---- build the Go sidecar ----
# Debian-based build stage (consistent with the core image's build stage); the
# static CGO-free binary it produces runs on any glibc base regardless.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/loomarr-ingest ./cmd/loomarr-ingest

# ---- runtime: needs ffmpeg + yt-dlp (unlike the core) ----
# debian:stable-slim (glibc), NOT Alpine: the LATEST upstream yt-dlp + ffmpeg
# binaries are built against glibc, and running them on musl (Alpine) fails with
# "exec: no such file or directory" (missing glibc loader). This is the ONLY image
# carrying that tooling; the core stays static/distroless, so a slightly larger
# glibc base here is fine.
#
# §14 tooling policy: bundle the LATEST yt-dlp + ffmpeg, not distro packages —
# distros lag (Debian/Alpine ship yt-dlp months behind), and a stale yt-dlp is a
# real failure mode (YouTube changes its player/signature extraction constantly,
# and old yt-dlp gets throttled or can't extract). So:
#   - yt-dlp: the official self-contained `yt-dlp_linux` release binary (bundles
#     its own Python via PyInstaller — no system Python needed), pinned by version.
#   - ffmpeg: BtbN's static ffmpeg 7.1 GPL build.
# Both are pinned to a specific version so builds are reproducible; bump these two
# ARGs to update (a one-line change, recorded in §14).
FROM debian:stable-slim
ARG YTDLP_VERSION=2026.07.04
ARG FFMPEG_BUILD=ffmpeg-n7.1-latest-linux64-gpl-7.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && useradd -u 10001 -m -s /usr/sbin/nologin ingest \
    # yt-dlp: latest official self-contained linux binary
    && curl -fsSL -o /usr/local/bin/yt-dlp \
       "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
    && chmod +x /usr/local/bin/yt-dlp \
    # ffmpeg 7.1: static GPL build (extract just ffmpeg + ffprobe)
    && curl -fsSL -o /tmp/ffmpeg.tar.xz \
       "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/${FFMPEG_BUILD}.tar.xz" \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp \
    && cp /tmp/${FFMPEG_BUILD}/bin/ffmpeg /tmp/${FFMPEG_BUILD}/bin/ffprobe /usr/local/bin/ \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe \
    && rm -rf /tmp/ffmpeg.tar.xz /tmp/${FFMPEG_BUILD} \
    # drop the fetch-only tooling + apt lists to keep the image lean
    && apt-get purge -y curl xz-utils \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/loomarr-ingest /usr/local/bin/loomarr-ingest
# The drop-folder is a bind/volume mount Tunarr scans as a `local` source (§10).
ENV INGEST_DROP_DIR=/drop \
    YT_DLP_PATH=/usr/local/bin/yt-dlp \
    FFMPEG_PATH=/usr/local/bin/ffmpeg
VOLUME ["/drop"]
USER ingest
ENTRYPOINT ["/usr/local/bin/loomarr-ingest"]
