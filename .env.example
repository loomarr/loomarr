# Loomarr configuration (design §15). Copy to .env and fill in. Secrets may also
# be provided via mounted files; never bake them into the image.
# Required markers: (req) always · (req*) or the direct arr requester ·
# (req†) only if the suggester is enabled.

# ---- Core ----
LISTEN_ADDR=:8080
LOG_LEVEL=info
TZ=UTC                                   # time-slot schedules are computed here (§9)

# ---- Store ----
DATABASE_URL=sqlite:///data/loomarr.db   # (req) or postgres://user:pass@host/db
AUTO_MIGRATE=true

# ---- Library — Emby/Jellyfin ----
LIBRARY_FLAVOR=emby                      # (req) emby | jellyfin
LIBRARY_URL=http://emby:8096             # (req)
LIBRARY_TOKEN=                           # (req) admin API key (header auth; never a query param)
SEASON_PRECISION=series                  # series (default) | seasons

# ---- Requester — Seerr (default) ----
SEERR_URL=http://seerr:5055              # (req*)
SEERR_API_KEY=                           # (req*)
# ...or the direct arr requester instead of Seerr:
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# ---- Ingest webhooks ----
WEBHOOK_SECRET=                          # (req) verifies /hooks/arr?token=...
EVENT_WEBHOOK_URL=                       # optional external event target

# ---- Programmer — Tunarr ----
TUNARR_URL=http://tunarr:8000            # (req)
TUNARR_API_KEY=                          # optional (confirmed optional for Tunarr 1.3.8)
TUNARR_TRANSCODE_CONFIG_ID=              # optional; transcode-config uuid channels reference (empty → wizard resolves Default)

# ---- Provisioning / scheduling ----
REQUEST_TTL=48h
DOWNLOADING_TTL=12h
RECONCILE_EVERY=5m
CHANNEL_RECONCILE_EVERY=10m
SCHED_DEFAULT_STRATEGY=shuffle           # shuffle | ordered | timeslot
SCHED_BACKFILL=stable                    # stable (default) | reshuffle

# ---- Users, auth, sessions ----
SESSION_SECRET=                          # (req) signs session cookies
SESSION_TTL=720h
COOKIE_SECURE=auto                       # auto | true | false
API_TOKEN=                               # optional machine access + break-glass admin
USER_SYNC_EVERY=1h

# ---- Jobs / suggester ----
JOB_WORKERS=2
JOB_TIMEOUT=10m
JOBS_RETENTION=720h
PROPOSALS_RETENTION=2160h
LLM_PROVIDER=ollama                      # (req†) ollama | anthropic
LLM_URL=http://ollama:11434
LLM_MODEL=                               # (req†) model id
LLM_API_KEY=                             # required for anthropic
TMDB_API_KEY=                            # (req†) grounds suggestions
SUGGEST_AUTO_APPROVE=false
SUGGEST_MAX_ACQUISITIONS=10

# ---- Filler / commercials ----
FILLER_DIR=                              # drop-folder path Loomarr registers as a Tunarr `local` media source (§10); with the filler profile, set to /filler
# FILLER_DROP_DIR=                       # host bind-mount for the drop-folder (defaults to the filler-drop named volume); mount the same path into Tunarr
FILLER_SYNC_EVERY=15m
FILLER_AI_TAGGING=false
FILLER_BREAKS_PER_HOUR=4
FILLER_POD_MAX=4
