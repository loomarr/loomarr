# Loomarr configuration (design §15). Copy to .env and fill in. Secrets may also
# be provided via mounted files; never bake them into the image.
# Required markers: (req) always · (req*) or the direct arr requester ·
# (req†) only if the suggester is enabled.

# ---- Core ----
LISTEN_ADDR=:8080
LOG_LEVEL=info
TZ=UTC                                   # time-slot schedules are computed here (§9)

# ---- Store ----
DATABASE_URL=sqlite:///data/loomarr.db   # (req) or postgres://user:pass@host/db
AUTO_MIGRATE=true

# ---- Library — Emby/Jellyfin ----
LIBRARY_FLAVOR=emby                      # (req) emby | jellyfin
LIBRARY_URL=http://emby:8096             # (req)
LIBRARY_TOKEN=                           # (req) admin API key (header auth; never a query param)

# ---- Requester — Seerr (default) ----
SEERR_URL=http://seerr:5055              # (req*)
SEERR_API_KEY=                           # (req*)
# ...or the direct arr requester instead of Seerr:
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# ---- Playout (§9.1) — who actually streams a channel ----
# SERVER_PUBLIC_URL is the address your MEDIA SERVER and ffmpeg use to reach Loomarr, not
# a bind address: 127.0.0.1 resolves on the box and nowhere else. Unset, channels appear in
# the guide and fail at tune time — there is no boot-time warning, so set it.
SERVER_PUBLIC_URL=http://loomarr:8080    # (req) e.g. http://<lan-or-tailscale-ip>:8080
PLAYOUT_BACKEND=internal                 # internal (default) | tunarr — overridable per channel
PLAYOUT_ENCODER=                         # empty → auto-detect (probes what YOUR ffmpeg build carries)
PLAYOUT_QUALITY_TIER=balanced            # efficient | balanced (default) | quality
PLAYOUT_AUDIO_LANGUAGE=eng               # ISO 639-2 preference, not a requirement
PLAYOUT_MAX_CHANNELS=4
# PLAYOUT_FFMPEG_PATH=ffmpeg             # only if ffmpeg is not on PATH (macOS brew: /opt/homebrew/bin/ffmpeg)
# PLAYOUT_PREPARED_DIR=/data/prepared    # persistent reusable programmes; not HLS scratch
# PLAYOUT_PREPARED_BUDGET_GB=512         # soft cap; recent playback stays protected
# PLAYOUT_FONT_PATH=                     # only to override card-label font discovery; a build
                                         # without drawtext renders an unlabelled card either way

# ---- Programmer — Tunarr (only when PLAYOUT_BACKEND=tunarr) ----
TUNARR_URL=http://tunarr:8000            # (req)
TUNARR_TRANSCODE_CONFIG_ID=              # optional; transcode-config uuid channels reference (empty → Loomarr resolves the instance Default automatically)

# ---- Provisioning / scheduling ----
REQUEST_TTL=48h
DOWNLOADING_TTL=12h
CHANNEL_RECONCILE_EVERY=10m

# ---- Guide ----
GUIDE_TIMEZONE=                          # IANA name; empty → each viewer's own device timezone
GUIDE_RETENTION_HOURS=24

# ---- Backup (§16) ----
# A backup is the WHOLE instance, generated secrets included — treat the file as a credential.
BACKUP_SCHEDULE=0 30 3 * * *
BACKUP_RETAIN=7
BACKUP_DIR=/data/backups                 # container-shaped; point elsewhere for a native run

# ---- Users, auth, sessions ----
SESSION_TTL=720h
COOKIE_SECURE=auto                       # auto | true | false
API_TOKEN=                               # optional machine access + break-glass admin

# ---- Jobs / suggester ----
JOB_WORKERS=2
JOB_TIMEOUT=10m
JOBS_RETENTION=720h
PROPOSALS_RETENTION=2160h
LLM_PROVIDER=ollama                      # (req†) ollama | openai (OpenAI-compatible: OpenAI/Gemini/Groq/OpenRouter/… or Ollama's own /v1)
LLM_URL=http://ollama:11434              # ollama: base URL. openai: the OpenAI-compatible base ending in /v1 (e.g. https://api.openai.com/v1, or http://ollama:11434/v1)
LLM_MODEL=                               # (req†) model id. Local default: qwen3:14b — use a Q6_K quant (stock Q4 degrades tool-calling)
LLM_API_KEY=                             # required for LLM_PROVIDER=openai (hosted)
TMDB_API_KEY=                            # (req†) grounds suggestions
SUGGEST_MAX_ACQUISITIONS=10

# ---- Filler / commercials ----
FILLER_DIR=                              # drop-folder path Loomarr registers as a Tunarr `local` media source (§10); with compose, set to /filler (the mount). In-app clip download needs no profile and no image tag; the tooling ships in the image.
# FILLER_DROP_DIR=                       # host bind-mount for the drop-folder (defaults to the filler-drop named volume); mount the same path into Tunarr
FILLER_SYNC_EVERY=15m
FILLER_AI_TAGGING=false
FILLER_BREAKS_PER_HOUR=4
FILLER_POD_MAX=4
FILLER_COOLDOWN_SECONDS=30
FILLER_WEIGHT=1
