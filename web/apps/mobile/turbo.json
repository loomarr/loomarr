{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "doctor": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/apple-testflight-config.cjs",
        "$TURBO_ROOT$/scripts/with-*.cjs",
        "!$TURBO_ROOT$/scripts/with-*.test.cjs"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/apple-testflight-config.cjs",
        "$TURBO_ROOT$/scripts/with-*.cjs",
        "!$TURBO_ROOT$/scripts/with-*.test.cjs"
      ]
    },
    "bundle": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/apple-testflight-config.cjs",
        "$TURBO_ROOT$/scripts/with-*.cjs",
        "!$TURBO_ROOT$/scripts/with-*.test.cjs"
      ]
    }
  }
}
