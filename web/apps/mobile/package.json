{
  "name": "@loomarr/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo touch client; development builds keep the prototype identity and only the TestFlight release selects media.loomarr.mobile (ADR 0042).",
  "scripts": {
    "start": "expo start",
    "storybook": "EXPO_PUBLIC_LOOMARR_STORYBOOK_DENSITY=touch STORYBOOK_ENABLED=true expo start",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bundle": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@loomarr/api": "workspace:*",
    "@loomarr/core": "workspace:*",
    "@loomarr/crash-reports-native": "workspace:*",
    "@loomarr/design-system": "workspace:*",
    "@loomarr/lan-discovery-native": "workspace:*",
    "@loomarr/player": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-video": "58.0.13",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@loomarr/fixtures": "workspace:*",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.5",
    "typescript": "7.0.2"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ],
        "exclude": [
          "@loomarr/lan-discovery-native",
          "react-native-reanimated",
          "react-native-worklets"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-modules-core"
        ],
        "exclude": [
          "react-native-reanimated"
        ]
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
