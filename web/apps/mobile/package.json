{
  "name": "@loomarr/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Prototype Expo touch client; not a shipping application identity before adoption.",
  "scripts": {
    "start": "expo start",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bundle": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@loomarr/design-system": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.2",
    "typescript": "~7.0.2"
  }
}
