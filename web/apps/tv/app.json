{
  "expo": {
    "name": "Loomarr TV Prototype",
    "slug": "loomarr-tv-prototype",
    "version": "0.0.1",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "media.loomarr.tv.prototype",
      "infoPlist": {
        "NSBonjourServices": ["_loomarr._tcp"],
        "NSLocalNetworkUsageDescription": "Loomarr looks for your Loomarr server on your home network and connects to it."
      }
    },
    "android": {
      "package": "media.loomarr.tv.prototype",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      }
    },
    "plugins": [
      "../../scripts/with-loomarr-ios-network.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0E",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0B0C0E"
          }
        }
      ],
      "../../scripts/with-memory-safe-android-build.cjs",
      "../../scripts/with-workspace-bundle-inputs.cjs",
      "../../scripts/with-shield-release-signing.cjs",
      "../../scripts/with-loomarr-android-network.cjs",
      "../../scripts/with-loomarr-fonts.cjs",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "appleTVImages": {
            "icon": "./assets/apple-tv/icon-1280x768.png",
            "iconSmall": "./assets/apple-tv/icon-400x240.png",
            "iconSmall2x": "./assets/apple-tv/icon-800x480.png",
            "topShelf": "./assets/apple-tv/top-shelf-1920x720.png",
            "topShelf2x": "./assets/apple-tv/top-shelf-3840x1440.png",
            "topShelfWide": "./assets/apple-tv/top-shelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/apple-tv/top-shelf-wide-4640x1440.png"
          },
          "removeFlipperOnAndroid": true
        }
      ],
      "expo-secure-store"
    ]
  }
}
