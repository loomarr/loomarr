{
  "name": "@loomarr/tv",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Prototype Expo TV client; it cannot replace the shipping Compose package before adoption.",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "storybook": "EXPO_PUBLIC_LOOMARR_STORYBOOK_DENSITY=tv EXPO_TV=1 STORYBOOK_ENABLED=true expo start",
    "doctor": "EXPO_TV=1 expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bundle": "EXPO_TV=1 expo export --platform android --output-dir dist/android-tv && EXPO_TV=1 expo export --platform ios --output-dir dist/apple-tv"
  },
  "dependencies": {
    "@loomarr/core": "workspace:*",
    "@loomarr/design-system": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "@react-native-tvos/config-tv": "0.1.6",
    "expo": "~57.0.18",
    "expo-keep-awake": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.8",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@loomarr/fixtures": "workspace:*",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.3",
    "typescript": "~7.0.2"
  }
}
