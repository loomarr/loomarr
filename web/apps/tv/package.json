{
  "name": "@loomarr/tv",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo TV client with an isolated prototype identity and explicit permanent-identity Shield and Apple TV release builds.",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "storybook": "EXPO_PUBLIC_LOOMARR_STORYBOOK_DENSITY=tv EXPO_TV=1 STORYBOOK_ENABLED=true expo start",
    "doctor": "EXPO_TV=1 expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:emulator": "../../scripts/test-tv-emulator-journey.sh",
    "references:capture": "../../scripts/capture-tv-native-references.sh",
    "bundle": "EXPO_TV=1 expo export --platform android --output-dir dist/android-tv && EXPO_TV=1 expo export --platform ios --output-dir dist/apple-tv"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@loomarr/core": "workspace:*",
    "@loomarr/design-system": "workspace:*",
    "@loomarr/lan-discovery-native": "workspace:*",
    "@loomarr/player": "workspace:*",
    "@loomarr/ui": "workspace:*",
    "@loomarr/ui-tv": "workspace:*",
    "@react-native-tvos/config-tv": "0.1.7",
    "expo": "58.0.20",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.10",
    "expo-keep-awake": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-video": "58.0.12",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@loomarr/fixtures": "workspace:*",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.5",
    "typescript": "7.0.2"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
