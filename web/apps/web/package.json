{
  "name": "@loomarr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loomarr web app — Vite + React 18 + Tailwind v4 + shadcn (Test Card).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm bundle:check",
    "bundle:check": "node ../../../scripts/check-fe-bundle.mjs",
    "preview": "vite preview",
    "generate:routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@loomarr/api": "workspace:*",
    "@loomarr/core": "workspace:*",
    "@loomarr/fixtures": "workspace:*",
    "@loomarr/tokens": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.17",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@playwright/test": "1.62.0",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.167.19",
    "@tanstack/router-plugin": "^1.168.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  }
}
