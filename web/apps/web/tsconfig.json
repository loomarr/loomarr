{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "jsx": "react-jsx",
    // ⚠ `vite/client` is what declares the side-effect module types — `*.css`, and the
    // font packages `main.tsx` imports for their bundled assets. Listing `types` at all
    // OPTS OUT of automatic @types discovery, so omitting it here left those imports
    // undeclared. TypeScript 5 tolerated that silently; TypeScript 7 reports TS2882, which
    // is the more honest answer — the declarations were always missing.
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
