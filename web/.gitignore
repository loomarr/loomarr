# Dependencies
node_modules/
.pnpm-store/

# Build output (the app's dist is synced into internal/web/dist by `make fe`)
apps/web/dist/
*.tsbuildinfo

# Storybook static gallery — a build artifact (Playwright snapshots it); regenerated by
# `make storybook-build`. The visual BASELINES under tests/visual/*-snapshots/ ARE
# committed (reviewed as images in the PR) and are not ignored.
apps/web/storybook-static/

# Test / tooling
coverage/
playwright-report/
test-results/
.vite/

# Visual baselines are the CI/Docker (Linux) rasterizer's only (§5.2). Local macOS /
# Windows runs write throwaway platform-suffixed snapshots — never commit those; the
# committed *-linux.png baselines are generated by `make fe-visual-update` in the
# official Playwright Docker image (pinned to the @playwright/test version).
apps/web/tests/visual/**/*-darwin.png
apps/web/tests/visual/**/*-win32.png

# packages/tokens/generated/ is COMMITTED on purpose — `make fe-tokens` regenerates
# it and CI fails on drift (committed-artifact discipline, §2.5).
# packages/api/generated/ is orval output regenerated deterministically from
# api/openapi.yaml by `make fe` (pnpm codegen) — gitignored to keep the tree clean;
# there's nothing to drift against since the spec is the single source of truth.
packages/api/generated/
