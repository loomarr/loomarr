    "@types/react-dom": "19.3.0",
    "expo-haptics": "58.0.7",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
