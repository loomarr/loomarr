{
  "name": "@loomarr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orval-generated types + TanStack Query hooks from api/openapi.yaml (platform-agnostic).",
  "exports": {
    ".": "./src/index.ts",
    "./mutator": "./src/mutator/index.ts",
    "./zod": "./src/zod/index.ts",
    "./msw": "./src/msw/index.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "msw": "^2.15.0",
    "orval": "^8.23.0",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
