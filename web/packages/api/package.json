{
  "name": "@loomarr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orval-generated types + TanStack Query hooks from api/openapi.yaml (platform-agnostic).",
  "exports": {
    ".": "./index.ts",
    "./endpoints/*": "./endpoint-*.ts",
    "./models/*": "./model-*.ts",
    "./mutator": "./mutator.ts",
    "./msw": "./msw.ts",
    "./unwrap": "./unwrap.ts",
    "./zod": "./zod.ts",
    "./zod/*": "./zod-*.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts && node scripts/generate-entrypoints.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "msw": "^2.15.0",
    "orval": "^8.26.0",
    "react": "19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
