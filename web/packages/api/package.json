{
  "name": "@loomarr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orval-generated types + TanStack Query hooks from api/openapi.yaml (platform-agnostic).",
  "exports": {
    ".": "./src/index.ts",
    "./mutator": "./src/mutator/index.ts"
  },
