  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "orval": "^8.23.0",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
