diff --git a/apple/scripts/build-xcframework.sh b/apple/scripts/build-xcframework.sh
index e38a4d2..9bb906e 100755
--- a/apple/scripts/build-xcframework.sh
+++ b/apple/scripts/build-xcframework.sh
@@ -239,6 +239,10 @@ build_slice() {
   # DEVELOPER_DIR and TOOLCHAINS are forwarded so the nested build uses the same Xcode and
   # Swift toolchain as compute_hash and the app build, not the xcode-select Xcode or the
   # default toolchain.
+  #
+  # No -quiet: Xcode 27's quiet mode reports each warning-only SwiftCompile task
+  # as "error: the following command failed with exit code 0", and the parent
+  # build fails this script phase for printing an error it did not exit with.
   (cd "$PACKAGE_DIR" && env -i PATH="$PATH" HOME="$HOME" PODS_ROOT="$PODS_ROOT" RN_ROOT="$RN_ROOT" \
     ${DEVELOPER_DIR:+"DEVELOPER_DIR=$DEVELOPER_DIR"} ${TOOLCHAINS:+"TOOLCHAINS=$TOOLCHAINS"} \
     EXPO_CUSTOM_BUILD_ROOT="$BUILD_ROOT" \
@@ -249,7 +253,6 @@ build_slice() {
     -destination "generic/platform=${destination}" \
     -derivedDataPath "$DERIVED_DATA_PATH" \
     -configuration "$CONFIGURATION" \
-    -quiet \
     -disableAutomaticPackageResolution \
     -skipPackagePluginValidation \
     -skipMacroValidation \
