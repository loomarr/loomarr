+// One client for the process. Every source's client derives from it with newBuilder(), which shares
+// its connection pool and dispatcher, so replacing a source reuses the warm connection (and TLS
+// session) instead of opening a new one per source.
+private val sharedOkHttpClient: OkHttpClient by lazy { OkHttpClient() }
+
 @OptIn(UnstableApi::class)
 fun buildOkHttpDataSourceFactory(
   context: Context,
   videoSource: VideoSource,
   cacheStorageKey: String? = null
 ): OkHttpDataSource.Factory {
-  val clientBuilder = OkHttpClient.Builder()
+  val clientBuilder = sharedOkHttpClient.newBuilder()
   if (videoSource.useCaching) {
     clientBuilder.addNetworkInterceptor(buildCacheVariantRecorder(context, videoSource, cacheStorageKey))
   }
