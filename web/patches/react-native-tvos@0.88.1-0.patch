diff --git a/scripts/cocoapods/pinned_artifacts.rb b/scripts/cocoapods/pinned_artifacts.rb
new file mode 100644
index 0000000..6a8a1cb
--- /dev/null
+++ b/scripts/cocoapods/pinned_artifacts.rb
@@ -0,0 +1,52 @@
+# Loomarr: one checked acquisition path for the pinned Apple binary artifacts.
+require 'digest'
+require 'open3'
+require 'uri'
+require 'tempfile'
+require 'fileutils'
+
+module ReactNativePinnedArtifacts
+  def self.fetch(url, destination)
+    _stdout, stderr, status = Open3.capture3(
+      'curl', '--fail', '--location', '--silent', '--show-error',
+      '--connect-timeout', '10', '--max-time', '120', '--retry', '3',
+      '--retry-all-errors', '--retry-max-time', '180', '--output', destination, url)
+    abort("[ReactNative] HTTP acquisition failed for #{url}: #{stderr.strip}") unless status.success?
+  end
+
+  def self.acquire(url, filename, destination_dir, cache_dir, skip_cache, fetcher = method(:fetch))
+    expected = Tempfile.create('react-native-sha1') do |file|
+      fetcher.call("#{url}.sha1", file.path)
+      digest = File.read(file.path).strip
+      abort("[ReactNative] Invalid SHA1 metadata for #{url}") unless digest.match?(/\A[a-fA-F0-9]{40}\z/)
+      digest.downcase
+    end
+    FileUtils.mkdir_p(destination_dir)
+    destination = File.join(destination_dir, filename)
+    cached = File.join(cache_dir, filename)
+    (skip_cache ? [] : [destination, cached]).each do |candidate|
+      next unless File.file?(candidate)
+      if Digest::SHA1.file(candidate).hexdigest == expected
+        FileUtils.cp(candidate, destination) unless candidate == destination
+        return destination
+      end
+      File.delete(candidate)
+    end
+    Tempfile.create(['react-native-', '.download'], destination_dir) do |file|
+      fetcher.call(url, file.path)
+      actual = Digest::SHA1.file(file.path).hexdigest
+      abort("[ReactNative] SHA1 mismatch for #{filename}: expected #{expected}, got #{actual}") unless actual == expected
+      FileUtils.mv(file.path, destination)
+    end
+    unless skip_cache
+      FileUtils.mkdir_p(cache_dir)
+      FileUtils.cp(destination, cached)
+    end
+    destination
+  end
+
+  def self.local_source(path)
+    escaped = URI::DEFAULT_PARSER.escape(File.expand_path(path), /[^a-zA-Z0-9\-._~\/]/)
+    { :http => "file://#{escaped}", :sha1 => Digest::SHA1.file(path).hexdigest }
+  end
+end
