+# Bounded, checked acquisition shared by metadata and archive requests. Argument
+# arrays avoid shell interpolation; failed/partial bytes never enter either cache.
+def hermes_fetch(url, destination)
+    _stdout, stderr, status = Open3.capture3(
+      'curl', '--fail', '--location', '--silent', '--show-error',
+      '--connect-timeout', '10', '--max-time', '120', '--retry', '3',
+      '--retry-all-errors', '--retry-max-time', '180', '--output', destination, url)
+    abort("[Hermes] HTTP acquisition failed for #{url}: #{stderr.strip}") unless status.success?
+end
