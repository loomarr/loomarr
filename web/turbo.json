{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "vitest.universal.config.ts",
    "react-native-svg-sound-module.web.js",
    ".rnstorybook/**",
    "!.rnstorybook/storybook.requires.ts",
    "native-stories/**",
    "scripts/apple-testflight-config.cjs",
    "scripts/with-*.cjs",
    "!scripts/with-*.test.cjs",
    "packages/api/generated/**",
    "packages/api/endpoint-*.ts",
    "packages/api/model-*.ts",
    "packages/api/zod-*.ts"
  ],
  "tasks": {
    "doctor": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/design-system/native-fonts.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["typecheck", "^test"],
      "env": ["JAVA_HOME"],
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["typecheck", "^typecheck"],
      "outputs": ["dist/**"]
    },
    "client-proof": {
      "dependsOn": ["^typecheck"],
      "outputs": [".client-platform-proof/**"]
    }
  }
}
