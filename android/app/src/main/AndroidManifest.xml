<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ⚠ These three lines are what make this an Android TV app to the SYSTEM, and none of them
         name a device. Leanback is the TV UI feature; marking it not-required would also allow
         phones, which we do not want to claim. Touchscreen not-required is the important one: a TV
         has none, and the default is `required=true`, so omitting this hides the app from every TV
         in the Play Store. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoomarrTv">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.LoomarrTv">
            <!-- LEANBACK_LAUNCHER, not LAUNCHER: the TV home screen only shows the former. An app
                 with only the phone category installs on a TV and is then unreachable. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
