# Stops editorconfig resolution here rather than walking up into the repo root, where the web
# module's settings would otherwise apply to Kotlin.
root = true

# ktlint configuration for the Android TV client.
#
# The web module settles style with Biome so it is decided by a tool rather than in review; this is
# the Kotlin equivalent, and it exists for the same reason.

[*.{kt,kts}]
# 4 spaces, matching the Kotlin and Android conventions the AOSP and Compose samples use. ktlint's
# own default is 4; stating it keeps a future ktlint version from changing the whole tree silently.
indent_size = 4
indent_style = space
max_line_length = 120

# ⚠ @Composable functions are PascalCase by official Compose convention (`PairingScreen`, not
# `pairingScreen`), which ktlint's standard function-naming rule — written for ordinary Kotlin
# functions — flags. Renaming them would break from every Compose codebase and sample, so the rule
# is disabled rather than the convention abandoned.
#
# The trade: ordinary non-composable functions lose their camelCase check too. ktlint has no way to
# scope this rule to non-composables, and the Compose convention is the one worth keeping.
ktlint_standard_function-naming = disabled

# ⚠ Disabled because it CONTRADICTS ktlint's own formatter. `ktlintFormat` writes
# `suspend fun start(...): Pairing = withContext(Dispatchers.IO) {` (the function-signature rule
# prefers the body on the signature line when it fits), and then `ktlintCheck` rejects that exact
# output as a multiline expression that should start on a new line.
#
# Left on, `make android-fmt` produces code `make android` refuses — a gate nobody can satisfy,
# which is worse than no gate. The formatter's own output is the arbiter.
ktlint_standard_multiline-expression-wrapping = disabled
