# Question: what happens when someone tunes a channel?
# Reads top to bottom: a tune goes in at the top, one timeline serves every viewer at the bottom.
...@system/theme

direction: down

viewer: Someone tunes in {class: audience; icon: icons/audience-users.svg}
file: Your media file {class: service; icon: icons/service-file-video-camera.svg}

packager: Channel packager {
  class: boundary
  schedule: Schedule {class: loomarr; icon: icons/loomarr-calendar-clock.svg}
  encoder: ffmpeg, per item {class: loomarr; icon: icons/loomarr-cpu.svg}
  slate: Slate {class: service; icon: icons/service-presentation.svg}
  timeline: Timeline {class: loomarr; icon: icons/loomarr-list-video.svg}
}

hls: Browsers, TV app {class: audience; icon: icons/audience-monitor-play.svg}
ts: Emby or Jellyfin {class: audience; icon: icons/audience-tv.svg}

viewer -> packager.schedule: first tune {class: hot}
packager.schedule -> packager.encoder {class: hot}
file -> packager.encoder {class: flow}
packager.encoder -> packager.timeline {class: hot}
packager.slate -> packager.timeline: if late {class: flow}
packager.timeline -> hls: HLS {class: hot}
packager.timeline -> ts: MPEG-TS {class: hot}
