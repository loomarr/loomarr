---
// The site's front door. It lives here rather than in docs/ because it is the one page that
// only the site has: GitHub shows docs/README.md for the folder and the app opens Help on
// Get started, so neither needs a landing page, and splash frontmatter would print as a table
// on GitHub.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Card, CardGrid, LinkCard } from "@astrojs/starlight/components";
import SpotArt from "../components/SpotArt.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<StarlightPage
  frontmatter={{
    title: "Loomarr",
    description: "Always something on. Loomarr turns your media library into live TV channels.",
    template: "splash",
    hero: {
      // The drawing already says "always something on", so the lede starts after it.
      tagline:
        "Describe a channel in a sentence; Loomarr fills it from your library, plays it as live TV and keeps it running.",
      actions: [
        { text: "Get started", link: `${base}/get-started/`, icon: "right-arrow" },
        {
          text: "View on GitHub",
          link: "https://github.com/loomarr/loomarr",
          icon: "external",
          variant: "minimal",
        },
      ],
    },
  }}
>
  <CardGrid>
    <Card title="Get started">
      <SpotArt name="get-started" />
      Install Loomarr with Docker, connect your media server and put your first channel on air.
    </Card>
    <Card title="Guides">
      <SpotArt name="guides" />
      Step-by-step tasks: add a channel, set up filler, hardware encoding, backups and upgrades.
    </Card>
    <Card title="Reference">
      <SpotArt name="reference" />
      Every setting and command, generated from the code so it can't drift.
    </Card>
    <Card title="Explanation">
      <SpotArt name="explanation" />
      How Loomarr works: channels, proposals, curation and what leaves your network.
    </Card>
  </CardGrid>
  <div class="lm-contributing">
    <SpotArt name="contributing" />
    <LinkCard
      title="Contributing"
      description="Set up a dev loop, run the tests and learn how CI and releases work."
      href={`${base}/contributing/`}
    />
  </div>
</StarlightPage>

<style>
  .lm-contributing {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .lm-contributing > :global(.sl-link-card) {
    flex: 1;
  }

  .lm-contributing > :global(.lm-spot) {
    width: 8rem;
    flex: none;
  }

  @media (max-width: 40rem) {
    .lm-contributing {
      flex-direction: column;
      align-items: stretch;
    }

    .lm-contributing > :global(.lm-spot) {
      align-self: center;
    }
  }
</style>
