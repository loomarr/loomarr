---
// Section spot art for the landing page (#1572): one small idea per section, drawn from the
// hero's parts only (raised card with outline, the screen, a knob, the on-air light, static and
// the seven brand bars in their fixed order). Colours come from the --art-* variables in
// styles/custom.css so each drawing follows the site theme; the bars are the brand chroma.
// Decorative: each sits beside a heading that already says what the section is.
interface Props {
  name: "get-started" | "guides" | "reference" | "explanation" | "contributing";
}
const { name } = Astro.props;

// signal, caution, lock, tune, suggest, on-air, static
// (web/packages/design-system/src/tokens/brand-contract.json).
const chroma = ["#FFB020", "#F5D90A", "#3DD68C", "#4CC9E8", "#D6409F", "#E5484D", "#8B93A3"];
const snowId = `lm-spot-snow-${name}`;
const fadeId = `lm-spot-fade-${name}`;
---

<svg class="lm-spot" viewBox="0 0 200 120" aria-hidden="true" focusable="false">
  {
    name === "get-started" && (
      // On air: the set from the hero, bars across its screen and the on-air light lit.
      <g>
        <rect x="38" y="14" width="124" height="86" rx="16" fill="var(--art-raised)" stroke="var(--art-outline)" stroke-width="2" />
        <rect x="48" y="23" width="86" height="68" rx="10" fill="var(--art-ground)" />
        <g>
          {chroma.map((fill, i) => (
            <rect x={52 + i * 11.4} y="27" width="11.4" height="60" fill={fill} />
          ))}
        </g>
        <circle cx="148" cy="38" r="6" fill="var(--art-elevated)" stroke="var(--art-outline)" stroke-width="1.5" />
        <line x1="148" y1="38" x2="148" y2="33.5" stroke="var(--art-ink-2)" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="148" cy="82" r="3" fill="#E5484D" />
        <rect x="54" y="100" width="18" height="5" rx="2.5" fill="var(--art-outline)" />
        <rect x="128" y="100" width="18" height="5" rx="2.5" fill="var(--art-outline)" />
      </g>
    )
  }
  {
    name === "guides" && (
      // Steps: three cards, each one further along, the last one on air.
      <g>
        <rect x="20" y="16" width="64" height="40" rx="10" fill="var(--art-raised)" stroke="var(--art-outline)" stroke-width="2" />
        <rect x="30" y="28" width="36" height="4" rx="2" fill="var(--art-ink-2)" />
        <rect x="30" y="38" width="24" height="4" rx="2" fill="var(--art-outline)" />
        <rect x="68" y="44" width="64" height="40" rx="10" fill="var(--art-raised)" stroke="var(--art-outline)" stroke-width="2" />
        <rect x="78" y="56" width="36" height="4" rx="2" fill="var(--art-ink-2)" />
        <rect x="78" y="66" width="24" height="4" rx="2" fill="var(--art-outline)" />
        <rect x="116" y="72" width="64" height="40" rx="10" fill="var(--art-ground)" stroke="var(--art-outline)" stroke-width="2" />
        <g>
          {chroma.map((fill, i) => (
            <rect x={124 + i * 6.86} y="84" width="6.86" height="16" fill={fill} />
          ))}
        </g>
      </g>
    )
  }
  {
    name === "reference" && (
      // Every setting: a raised card of rows, each with its control; one found and on.
      <g>
        <rect x="36" y="10" width="128" height="100" rx="16" fill="var(--art-raised)" stroke="var(--art-outline)" stroke-width="2" />
        {[0, 1, 2, 3].map((row) => (
          <g transform={`translate(0 ${row * 22})`}>
            <rect x="50" y="26" width={[54, 40, 60, 46][row]} height="4" rx="2" fill={row === 2 ? "var(--art-ink)" : "var(--art-ink-2)"} />
            <rect x="126" y="21" width="24" height="14" rx="7" fill={row === 2 ? "var(--art-glow)" : "var(--art-elevated)"} stroke={row === 2 ? "none" : "var(--art-outline)"} stroke-width="1.5" />
            <circle cx={row === 2 ? 143 : 133} cy="28" r="4.5" fill={row === 2 ? "var(--art-raised)" : "var(--art-control)"} />
          </g>
        ))}
      </g>
    )
  }
  {
    name === "explanation" && (
      // Static becoming signal: the tuner loader's idea, snow at the top resolving into all
      // seven bars below.
      <g>
        <defs>
          <filter id={snowId} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="1" seed="4" />
            <feColorMatrix type="matrix" values="0 0 0 1.6 -.36  0 0 0 1.6 -.34  0 0 0 1.6 -.30  0 0 0 0 1" />
          </filter>
          <linearGradient id={fadeId} x1="0" x2="0" y1="0" y2="1">
            <stop offset=".15" stop-color="#fff" stop-opacity="0" />
            <stop offset=".6" stop-color="#fff" stop-opacity="1" />
          </linearGradient>
          <mask id={`${fadeId}-mask`}>
            <rect x="24" y="18" width="152" height="84" fill={`url(#${fadeId})`} />
          </mask>
        </defs>
        <rect x="20" y="14" width="160" height="92" rx="16" fill="var(--art-ground)" stroke="var(--art-outline)" stroke-width="2" />
        <rect x="24" y="18" width="152" height="84" rx="12" filter={`url(#${snowId})`} opacity=".9" />
        <g mask={`url(#${fadeId}-mask)`}>
          {chroma.map((fill, i) => (
            <rect x={24 + i * (152 / 7)} y="18" width={152 / 7} height="84" fill={fill} />
          ))}
        </g>
      </g>
    )
  }
  {
    name === "contributing" && (
      // Add your piece: the brand strip with one bar lifted out above its waiting slot.
      // The slot's dashes are the static bar's grey, which reads on the ground in both themes.
      <g>
        <rect x="24" y="58" width="152" height="50" rx="10" fill="var(--art-ground)" stroke="var(--art-outline)" stroke-width="2" />
        {chroma.map((fill, i) =>
          i === 3 ? (
            <rect x={31 + i * 20} y="65.75" width="18.5" height="34.5" fill="none" stroke={chroma[6]} stroke-width="1.5" stroke-dasharray="3 3" />
          ) : (
            <rect x={30 + i * 20} y="65" width="20" height="36" fill={fill} />
          ),
        )}
        <rect x="90" y="12" width="20" height="36" fill={chroma[3]} />
      </g>
    )
  }
</svg>

<style>
  .lm-spot {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
  }
</style>
