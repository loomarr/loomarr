SELECT ?item ?fid ?call ?start ?end ?coord WHERE {
  ?item wdt:P31/wdt:P279* wd:Q1616075 ; wdt:P17 wd:Q30 ;
        p:P2317 ?st .
  ?st ps:P2317 ?call .
  OPTIONAL { ?st pq:P580 ?start }
  OPTIONAL { ?st pq:P582 ?end }
  OPTIONAL { ?item wdt:P1400 ?fid }
  OPTIONAL { ?item wdt:P625 ?coord }
  FILTER(BOUND(?start) || BOUND(?end))
}
